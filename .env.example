# =========================
# MYSQL TINYHOST
# =========================

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# 0 normalmente.
# Metti 1 solo se TinyHost richiede TLS MySQL.
DB_SSL=0


# =========================
# FILE PROVIDER
# =========================

PAXTHEM_PALIMPSEST_FILE=./provider-data/palimpsest.json
PAXTHEM_MARKETGROUPS_FILE=./provider-data/marketgroups.json
PAXTHEM_LINKS_FILE=./provider-data/paxthem-links.txt


# =========================
# HTTP
# =========================

PAXTHEM_API_BASE=https://api.paxthem.com

PAXTHEM_LANGUAGE=it-IT
PAXTHEM_TIMEZONE=Europe/Rome

PAXTHEM_HTTP_CONCURRENCY=4
PAXTHEM_HTTP_DELAY_MS=150
PAXTHEM_HTTP_TIMEOUT_MS=15000
PAXTHEM_HTTP_RETRIES=2


# =========================
# SYNC
# 600000 = 10 minuti
# =========================

PAXTHEM_FULL_SYNC_INTERVAL_MS=600000


# =========================
# WEBSOCKET PUSHER
# =========================

PAXTHEM_WS_BASE=wss://ws.paxthem.com

PAXTHEM_WS_APP_KEY=

PAXTHEM_WS_RECONNECT_MIN_MS=1000
PAXTHEM_WS_RECONNECT_MAX_MS=30000


# =========================
# DATABASE BATCH
# =========================

ODDS_DB_BATCH_SIZE=500
